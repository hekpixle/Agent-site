# Hekpixle website environment configuration
# Copy this file to .env and edit values

# Server port
PORT=3000

# JWT secret — CHANGE THIS to a long random string in production
JWT_SECRET=irwm hypw feck nsqy

# Admin email — anyone who registers/logs in with this email gets admin access
# Default: admin@hekpixle.ir  (change to your own email)
ADMIN_EMAIL=hekpixleteam@gmail.com

# Site URL (used for cookies and CORS if needed)
SITE_URL=http://localhost:3000

# Optional: max upload size in MB (agent installer)
MAX_UPLOAD_MB=200
